# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.claude/worktrees
.claude/settings.local.json

test-output

# TypeScript incremental build info
*.tsbuildinfo

# Перенесено из корневого .gitignore: корневой файл не меняем (см. Readme.md)
.idea/
.qwen/
.junie/
.nx/
.env

# MongoDB data directories (docker volumes from compose.yaml)
**/mongodb/

# PostgreSQL data directories (docker volumes from compose.yaml)
**/postgres/

# RabbitMQ data directories (docker volumes from compose.yaml)
**/rabbitmq/

# Prisma generated clients
apps/blog/src/generated/
apps/users/src/generated/
apps/notify/src/generated/
apps/file-storage/src/generated/

# file-storage uploads (docker volume target / runtime artifacts)
apps/file-storage/uploads/
