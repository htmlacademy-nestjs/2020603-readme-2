{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "paths": {
      "@project/shared-types": ["libs/shared-types/src/index.ts"],
      "@project/shared-errors": ["libs/shared-errors/src/index.ts"],
      "@project/shared-config": ["libs/shared-config/src/index.ts"],
      "@project/shared-helpers": ["libs/shared-helpers/src/index.ts"]
    },
  },
}
